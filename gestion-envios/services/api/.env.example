# --- Obligatorias ---
# Supabase → Connect → "Session pooler" (IPv4). Los símbolos de la contraseña van URL-encodeados (! → %21, $ → %24).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
JWT_SECRET=changeme

# --- Generales ---
PORT=8080
CORS_ORIGINS=http://localhost:5173
ENV=development
# Aplica las migraciones al arrancar (en el Dockerfile ya viene en true).
MIGRATE_ON_START=false

# --- Sprint 3 ---
# URL pública de la web (links de seguimiento en los avisos) y del panel del repartidor.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:8081
# GPS simulado: mueve los camiones por sus rutas del día (x3 = 3 veces más rápido que la realidad).
SIMULADOR_GPS=true
SIMULADOR_FACTOR=3
# WhatsApp (whatsmeow). false = los códigos y avisos se escriben en el log en vez de enviarse.
WHATSAPP_HABILITADO=false
# Geocodificación (Nominatim) y recorridos (OSRM). Vacío = servidores públicos de OpenStreetMap.
GEOCODIFICAR=true
NOMINATIM_URL=
OSRM_URL=
# Recomendación al asignar un envío a una ruta (T4).
# osrm = Nominatim + OSRM (gratis). google = Geocoding + Distance Matrix (requiere GOOGLE_MAPS_KEY).
GEO_PROVIDER=osrm
GOOGLE_MAPS_KEY=
# Desvío (km) por debajo del cual "conviene" y por encima del cual "no conviene".
RECOMIENDA_UMBRAL_OK_KM=2
RECOMIENDA_UMBRAL_NO_KM=5

# --- Primer acceso (T1) ---
# Código de verificación: vigencia en minutos e intentos por código (se puede pedir uno por minuto).
OTP_TTL_MIN=10
OTP_MAX_INTENTOS=3
# Mail del código para usuarios sin celular (Resend, plan gratuito). Vacío = el mail se escribe en el log.
# MAIL_FROM tiene que ser de un dominio verificado en Resend (o onboarding@resend.dev para pruebas).
RESEND_API_KEY=
MAIL_FROM=Movii <no-reply@tu-dominio.com>

# --- Login con Google (T2) --- Vacío = el botón "Continuar con Google" no aparece.
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# GOOGLE_CALLBACK_URL tiene que estar cargada tal cual en "URI de redireccionamiento autorizados".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback
