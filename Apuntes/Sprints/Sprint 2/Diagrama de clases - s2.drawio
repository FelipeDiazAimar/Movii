        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\n   class Usuario {\n     +UUID id\n     +String nombre\n     +String email\n     +String password_hash\n     +String rol\n     +Boolean activo\n     +Timestamp created_at\n     +Timestamp updated_at\n   }\n\n   class Remitente {\n     +UUID id\n     +String nombre\n     +String telefono\n     +String direccion\n     +Timestamp created_at\n   }\n\n   class Destinatario {\n     +UUID id\n     +String nombre\n     +String telefono\n     +String calle\n     +String numero\n     +String piso_depto\n     +String localidad\n     +String codigo_postal\n     +Timestamp created_at\n   }\n\n   class Ruta {\n     +UUID id\n     +String nombre\n     +String zona\n     +Date fecha\n     +String estado\n     +UUID repartidor_id\n     +Timestamp created_at\n     +Timestamp updated_at\n   }\n\n   class Envio {\n     +UUID id\n     +String codigo_guia\n     +String estado\n     +Decimal peso\n     +String tamano\n     +String tipo_contenido\n     +Boolean fragil\n     +Boolean urgente\n     +UUID remitente_id\n     +UUID destinatario_id\n     +UUID ruta_id\n     +Date reprogramado_para\n     +String franja\n     +Timestamp created_at\n     +Timestamp updated_at\n   }\n\n   class EventoEnvio {\n     +UUID id\n     +UUID envio_id\n     +String estado_anterior\n     +String estado_nuevo\n     +String motivo\n     +String comentario\n     +Boolean tiene_foto\n     +UUID actor_id\n     +Timestamptz created_at\n   }\n\n   class ConfirmacionEntrega {\n     +UUID envio_id\n     +String receptor_nombre\n     +String receptor_relacion\n     +Bytes firma\n     +Bytes foto\n     +UUID confirmada_por\n     +Timestamptz confirmada_at\n   }\n\n   class Rol {\n     &lt;&lt;enumeration&gt;&gt;\n     operador\n     repartidor\n     supervisor\n   }\n\n   class EstadoEnvio {\n     &lt;&lt;enumeration&gt;&gt;\n     pendiente\n     asignado\n     en_camino\n     entregado\n     no_entregado\n   }\n\n   class TamanoPaquete {\n     &lt;&lt;enumeration&gt;&gt;\n     chico\n     mediano\n     grande\n   }\n\n   class EstadoRuta {\n     &lt;&lt;enumeration&gt;&gt;\n     planificada\n     en_curso\n     completada\n   }\n\n   class MotivoFallo {\n     &lt;&lt;enumeration&gt;&gt;\n     cliente_ausente\n     direccion_incorrecta\n     rechazado\n     zona_insegura\n     otro\n   }\n\n   class FranjaHoraria {\n     &lt;&lt;enumeration&gt;&gt;\n     manana\n     tarde\n     noche\n   }\n\n   class RelacionReceptor {\n     &lt;&lt;enumeration&gt;&gt;\n     destinatario\n     familiar\n     vecino\n     encargado\n   }\n\n   Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Ruta : reparte\n   Ruta \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Envio : contiene\n   Remitente \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Envio : origina\n   Destinatario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Envio : recibe\n   Envio \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EventoEnvio : historial\n   Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EventoEnvio : actua\n   Envio \&quot;1\&quot; --&gt; \&quot;0..1\&quot; ConfirmacionEntrega : evidencia\n   Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ConfirmacionEntrega : confirma\n   Usuario ..&gt; Rol : usa\n   Ruta ..&gt; EstadoRuta : usa\n   Envio ..&gt; EstadoEnvio : usa\n   Envio ..&gt; TamanoPaquete : usa\n   Envio ..&gt; FranjaHoraria : usa\n   EventoEnvio ..&gt; EstadoEnvio : usa\n   EventoEnvio ..&gt; MotivoFallo : usa\n   ConfirmacionEntrega ..&gt; RelacionReceptor : usa\n   note for Envio \&quot;reprogramado_para + franja HU-09. Se limpian al asignar.\&quot;\n   note for EventoEnvio \&quot;estado_anterior null en evento raiz. foto solo HU-07.\&quot;\n   note for ConfirmacionEntrega \&quot;Un envio = una confirmacion maximo. PK = envio_id.\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EtFtvmR-Xvn04eO4OHFP-263">
